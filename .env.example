# Desk Buddy Configuration
# Copy this file to .env and fill in your values.

# ElevenLabs (required for voice — buddy can still run without it)
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Pick a voice that fits your buddy's personality.
# These are free built-in ElevenLabs voices:
#   Charlie  — IKne3meq5aSn9XLyUdCD — warm, natural, boy-next-door
#   Daniel   — onwK4e9ZLuTAKqWW03F9 — calm, gentle, British
#   Josh     — TxGEqnHWrfWFTfGW9XjX — young, upbeat, golden retriever energy
# Or browse https://elevenlabs.io/voice-library for more.
ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD

# Pixoo 64 (optional — leave empty to use browser only)
PIXOO_IP=

# Buddy identity
BUDDY_NAME=Buddy
BUDDY_SPECIES=golden

# Network ports
BUDDY_WEB_PORT=3456
BUDDY_WS_PORT=3457

# Data directory (default: ~/.desk-buddy)
# DATA_DIR=~/.desk-buddy
